# This file adds rules specific to the experimental stage.
# General Python, OS, IDE and temporary-file rules are defined in ../.gitignore.

# Locally generated campaigns. Curated outputs belong in results/.
out/
raw-results/
q1_analysis_test/

# Heavy step-level analysis files
**/steps_flat.csv
**/steps_flat_all.csv
**/actuator_goal_rows.csv
**/paired_wilcoxon_tests.csv

# Python cache files may also appear inside legacy snapshots
**/__pycache__/
**/*.py[cod]
